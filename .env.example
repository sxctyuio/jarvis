# ============================================================================
#  JARVIS CONFIG  —  rename this file to ".env" (exactly, with the leading dot)
# ============================================================================
#  The server loads this automatically on startup. No re-exporting each session.
#
#  RULES:
#   - No spaces around the = sign.      GOOD: KEY=value    BAD: KEY = value
#   - No quotes needed around values.
#   - Lines starting with # are ignored (comments).
#   - Leave a key blank to disable that feature — it just won't be available.
#   - This file holds secrets. It's gitignored; never commit or share it.
#
#  Anything you `export` in the shell overrides what's here.
# ============================================================================


# ============================  REQUIRED  ====================================

# Anthropic — the brain. Jarvis won't start without this.
#   Get it: console.anthropic.com  ->  API Keys  ->  Create Key
ANTHROPIC_API_KEY=

# Duck robot SSH password. Required ONLY if you use the duck (run_on_duck) tool.
# Leave blank if you don't have the robot.
DUCK_PASSWORD=


# ==========================  VOICE (optional)  ==============================

# Fish Audio — PRIMARY text-to-speech (cheaper/better than ElevenLabs, free
# model window). This is the recommended voice.
#   Get it: fish.audio  ->  sign in  ->  API keys
FISH_API_KEY=

# Optional: a specific Fish voice. Browse fish.audio, open a voice, copy its
# reference_id, paste here. Blank = the model's default voice.
# FISH_REFERENCE_ID=

# Optional: which Fish model. Default is the free one. Leave unless you know why.
# FISH_MODEL=s2.1-pro-free

# ElevenLabs — FALLBACK voice, only used if Fish is unset/fails. Optional;
# you can skip this entirely now that Fish is primary.
#   Get it: elevenlabs.io  ->  profile  ->  API key
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=   # optional specific voice (must be a DEFAULT voice on free tier)


# =======================  TOOLS (all optional)  ============================

# News headlines (the `news` tool).
#   Get it (free): gnews.io  ->  sign up  ->  API key
NEWS_API_KEY=

# GitHub (the `github` tool: list repos/issues/PRs, read files).
#   Get it: github.com/settings/tokens  ->  fine-grained token
#   Scope: read-only on the repos you want (add Issues:write only to create issues)
GITHUB_TOKEN=

# Spotify (the `spotify` tool: play/pause/search).
#   Get it: developer.spotify.com/dashboard  ->  create app
#   In the app settings, add this exact redirect URI:
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback


# =========================  GOOGLE (no key here)  ==========================
# Gmail + Calendar need NO entry in this file. They use:
#   1) a client_secret.json file placed in this folder (from Google Cloud), and
#   2) the "Connect Google" button in the Jarvis header.
# See SETUP_INTEGRATIONS.md for the one-time Google Cloud setup.
